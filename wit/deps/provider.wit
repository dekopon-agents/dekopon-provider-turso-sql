package dekopon:provider@0.3.0;

/// A minimal JSON-over-WIT contract for experimental read-only providers.
world provider {
    /// Returns a JSON-encoded provider manifest.
    export describe: func() -> string;

    /// Invokes one declared capability and returns a JSON-encoded response.
    export invoke: func(capability: string, input-json: string) -> string;
}

/// A provider that also contributes command words to the sandboxed shell.
///
/// Separate from `provider` so a host can require the base contract and treat this export as
/// optional, letting a component built against an earlier package version keep loading. A provider
/// declaring command words in its manifest without exporting this is refused at load.
world provider-commands {
    include provider;

    /// Rewrites one argv into a capability proposal, as JSON.
    ///
    /// Pure: the result is a proposal, authorized exactly as any other. This grants nothing and
    /// must not depend on host imports.
    export resolve-command: func(argv: list<string>) -> string;
}

/// A provider whose command words behave like a command-line program.
///
/// Separate from `provider-commands` for the reason that world is separate from `provider`: a
/// host looks the export up by name and treats it as optional, so components built against
/// `0.1.0` and `0.2.0` keep loading, and a `0.2.0` `resolve-command` guest keeps working on the
/// same shell path. A manifest declaring command words must export one of the two; a host that
/// finds both calls this one.
world provider-cli {
    include provider;

    /// Runs one command word's argv and returns JSON: a capability proposal, rendered text with
    /// an exit status (help, version, usage errors), or a decline.
    ///
    /// `stdin` is the value piped into the word, absent when nothing was piped. Pure and
    /// import-free exactly as `resolve-command`: a proposal is authorized as any other, and
    /// rendered text is produced by the guest alone.
    export run-command: func(argv: list<string>, stdin: option<string>) -> string;
}
